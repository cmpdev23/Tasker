# Local database location (optional; defaults to ./agenttasker.db).
DATABASE_PATH=./agenttasker.db
# Optional machine-specific runtime data directory. Must be outside managed repositories.
# AGENTTASKER_DATA_DIR=/absolute/path/to/agenttasker-data
# Optional separate Next.js build output for an isolated test server.
# AGENTTASKER_BUILD_DIR=.test-artifacts/next-smoke
# ReUI Premium key is provided through the development machine environment.
# REUI_LICENSE_KEY=placeholder-not-a-real-key
