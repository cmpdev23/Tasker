{
  "name": "codex-tasker",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "bin": {
    "agenttasker": "./bin/agenttasker.mjs"
  },
  "scripts": {
    "predev": "node scripts/require-node-24.mjs",
    "dev": "next dev --port 5000",
    "prebuild": "node scripts/require-node-24.mjs",
    "build": "next build",
    "prestart": "node scripts/require-node-24.mjs",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "pretest": "node scripts/require-node-24.mjs",
    "test": "node scripts/run-tests.mjs",
    "preagenttasker": "node scripts/require-node-24.mjs",
    "agenttasker": "node bin/agenttasker.mjs",
    "db:generate": "drizzle-kit generate",
    "predb:migrate": "node scripts/require-node-24.mjs",
    "db:migrate": "node db/migrate.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@tanstack/react-table": "^9.2.4",
    "better-sqlite3": "^13.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.2.6",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.43.0",
    "next": "16.3.4",
    "next-themes": "^0.4.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "agentation": "^3.0.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "shadcn": "^4.21.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5"
  },
  "packageManager": "npm@10.7.0"
}
